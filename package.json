{
  "name": "ledgerwalk",
  "version": "0.1.0",
  "private": true,
  "description": "Audits recurring subscriptions from bank statements and billing emails, reads each provider's billing page with a hand-written browser agent, and suggests open-source alternatives.",
  "license": "MIT",
  "author": "SebStefenel <stefenel.sebastian@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebStefenel/Ledgerwalk.git"
  },
  "homepage": "https://github.com/SebStefenel/Ledgerwalk#readme",
  "bugs": {
    "url": "https://github.com/SebStefenel/Ledgerwalk/issues"
  },
  "keywords": [
    "subscriptions",
    "browser-agent",
    "playwright",
    "anthropic",
    "claude",
    "personal-finance"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/src/db/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "test": "tsx --test test/*.test.ts",
    "login": "tsx src/cli.ts login",
    "audit": "tsx src/cli.ts audit",
    "alternatives": "tsx src/cli.ts alternatives",
    "report": "tsx src/cli.ts report",
    "inbox": "tsx src/cli.ts inbox"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "otplib": "^13.5.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
