# Copy to .env (gitignored). Phase 1 CSV scanning needs none of these.

# Needed by: audit, alternatives, inbox
# ANTHROPIC_API_KEY=
# LEDGERWALK_MODEL=claude-opus-5

# Needed by: inbox (email receipts). Not needed with `inbox --dir <folder>`.
# For Gmail, turn on 2-step verification and generate an app password:
#   IMAP_HOST=imap.gmail.com
# Other providers: outlook -> outlook.office365.com, iCloud -> imap.mail.me.com,
# Fastmail -> imap.fastmail.com
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# Optional: raises the GitHub rate limit for the repo health check in phase 3.
# GITHUB_TOKEN=

# Per-service credentials for phase 2 are referenced by key name only — the model
# never sees a value, it emits e.g. NOTION_PASSWORD and the executor resolves it
# at fill time. Key names are derived from the service name in tasks/services.yaml.
# NOTION_EMAIL=
# NOTION_PASSWORD=
# NOTION_TOTP_SECRET=
